<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page">

  <%- include('../components/header') %>

  <main>
    <div class="container">

      <section class="shop-top glass glow-cyan">
        <div class="shop-top-left">
          <div class="badge">Neon Shop • Gear Drop</div>
          <h1 class="h1">Shop</h1>
          <p class="p">Premium gaming gear with a neon aesthetic. Pick your loadout.</p>

          <div class="shop-actions">
            <a class="btn btn-primary" href="#grid">Browse</a>
            <a class="btn btn-ghost" href="/">Back Home</a>
          </div>
        </div>

        <div class="shop-top-right">
          <div class="shop-orb"></div>
          <div class="shop-orb shop-orb-2"></div>
          <div class="shop-orb shop-orb-3"></div>
        </div>
      </section>

      <section class="shop-controls">
        <div class="shop-search glass">
          <input class="input shop-input" placeholder="Search (design only)..." />
          <button class="btn btn-ghost">Filter</button>
          <button class="btn btn-ghost">Sort</button>
        </div>

        <div class="shop-chips">
          <button class="chip chip-active">All</button>
          <button class="chip">Keyboards</button>
          <button class="chip">Mice</button>
          <button class="chip">Headsets</button>
          <button class="chip">Monitors</button>
        </div>
      </section>

<section id="grid" class="grid grid-3 shop-grid">
  <% if (products.length === 0) { %>
    <p class="p">No products available.</p>
  <% } %>

  <% products.forEach(function(product) { %>

    <article class="card product glow-hover">
      <div class="product-media">
        <div
          class="card-img product-img"
          style="background-image: url('<%= product.imageUrl %>'); background-size: cover; background-position: center;"
        ></div>

        <div class="product-tags">
        </div>
      </div>

      <div class="product-body">
        <h3 class="card-title"><%= product.title %></h3>
        <p class="product-desc"><%= product.description %></p>

        <div class="product-bottom">
          <div class="price-wrap">
            <div class="price"><%= product.price %></div>
            <div class="muted-mini">In stock</div>
          </div>

          <div class="product-cta">
            <button class="btn btn-primary" type="button">Add</button>
          </div>
        </div>
      </div>
    </article>

  <% }) %>
</section>


    </div>
  </main>

  <%- include('../components/footer') %>

</body>
</html>
