<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page">

  <%- include('../components/header') %>

  <% if (toast) { %>
    <div id="toast" class="toast glass glow-cyan"><%= toast %></div>
    <script>
      const t = document.getElementById('toast');
      setTimeout(() => { t && t.classList.add('toast-hide'); }, 2200);
      setTimeout(() => { t && t.remove(); }, 2800);
    </script>
  <% } %>


  <main>
    <div class="container">

      <h1 class="h1">Your Cart</h1>
      <p class="p">Review your selected gaming gear before checkout.</p>

      <div class="cart-layout">

        <section class="cart-items">
          <% if (!items || items.length === 0) { %>
            <div class="glass" style="padding:18px;">
              <p class="p" style="margin:0;">Your cart is empty.</p>
              <div style="height:12px;"></div>
              <a class="btn btn-primary" href="/shop">Go to Shop</a>
            </div>
          <% } else { %>

            <% items.forEach(function(item) { %>
              <article class="cart-item glass glow-hover">
                <div
                  class="cart-img"
                  style="background-image:url('<%= item.product.imageUrl %>'); background-size:cover; background-position:center;"
                ></div>

                <div class="cart-info">
                  <h3 class="cart-title"><%= item.product.title %></h3>
                  <p class="cart-desc"><%= item.product.description %></p>

                  <div class="cart-actions">
                    <div class="qty">
                      <form action="/cart/<%= item.productId %>/dec" method="POST" style="margin:0;">
                        <button class="qty-btn" type="submit">−</button>
                      </form>

                      <span class="qty-value"><%= item.quantity %></span>

                      <form action="/cart/<%= item.productId %>/inc" method="POST" style="margin:0;">
                        <button class="qty-btn" type="submit">+</button>
                      </form>
                    </div>

                    <form action="/cart/<%= item.productId %>/remove" method="POST" style="margin:0;">
                      <button class="btn btn-ghost" type="submit">Remove</button>
                    </form>
                  </div>
                </div>

                <div class="cart-price">
                  <div class="price"><%= (Number(item.product.price) * item.quantity).toFixed(2) %></div>
                </div>
              </article>
            <% }) %>

          <% } %>
        </section>

        <aside class="cart-summary glass glow-cyan">
          <h2 class="h2">Order Summary</h2>

          <div class="summary-row">
            <span>Subtotal</span>
            <span>$<%= Number(subtotal || 0).toFixed(2) %></span>
          </div>

          <div class="summary-row">
            <span>Shipping</span>
            <span>Free</span>
          </div>

          <div class="summary-row summary-total">
            <span>Total</span>
            <span>$<%= Number(total || 0).toFixed(2) %></span>
          </div>

          <% if (items && items.length > 0) { %>
            <form action="/cart/clear" method="POST" style="margin:0; display:flex; gap:10px; flex-wrap:wrap;">
              <button class="btn btn-ghost" type="submit">Clear cart</button>
                <form action="/checkout" method="POST" style="margin:0;">
                  <button class="btn btn-primary" type="submit">Checkout</button>
                </form>

            </form>
          <% } else { %>
            <button class="btn btn-primary" type="button" disabled>Checkout</button>
          <% } %>
        </aside>

      </div>

    </div>
  </main>

  <%- include('../components/footer') %>

</body>
</html>
