<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="page">
    <%- include('../components/header') %>

    <main>
      <div class="container">
        <section class="hero glass">
          <div class="hero-card">
            <div class="badge">Nodejs • Prisma • PostgreSQL</div>
            <h1 class="h1">Upgrade Your Gaming Setup</h1>
            <p class="p">Premium gaming gear. Maximum performance.</p>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <a class="btn btn-primary" href="/shop">Shop Now</a>
              <a class="btn btn-ghost" href="/register">Create account</a>
            </div>
          </div>

          <div class="hero-visual glow-pink"></div>
        </section>

        <div style="height:18px;"></div>

        <section>
          <h2 class="h2">Featured Gear</h2>

          <div class="grid grid-3">
            <% if (!featuredProducts || featuredProducts.length === 0) { %>
              <p class="p">No products yet.</p>
            <% } else { %>
              <% featuredProducts.forEach(p => { %>
                <article class="card">
                  <div class="card-img" style="background-image:url('<%= p.imageUrl %>'); background-size:cover; background-position:center;"></div>
                  <h3 class="card-title"><%= p.title %></h3>
                  <div class="card-meta">
                    <span class="price"><%= p.price %></span>

                    <% if (!user) { %>
                      <a class="btn btn-primary" href="/register">Add to cart</a>
                    <% } else { %>
                      <form action="/cart/add" method="POST" style="margin:0;">
                        <input type="hidden" name="productId" value="<%= p.id %>">
                        <button class="btn btn-primary" type="submit">Add to cart</button>
                      </form>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            <% } %>
          </div>
        </section>

      </div>
    </main>

    <%- include('../components/footer') %>
  </div>
</body>
</html>
