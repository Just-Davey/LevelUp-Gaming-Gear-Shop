<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page">
  <%- include('../components/header') %>

  <main>
    <div class="container">
      <section class="glass glow-cyan" style="padding:22px;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
          <div>
            <div class="badge">Admin • Products</div>
            <h1 class="h1">Products</h1>
            <p class="p">Create, edit, delete products.</p>
          </div>

          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a class="btn btn-primary" href="/admin/products/new">Add product</a>
            <a class="btn btn-ghost" href="/admin">Back</a>
          </div>
        </div>

        <div style="height:14px;"></div>

        <% if (!products || products.length === 0) { %>
          <p class="p">No products yet.</p>
        <% } else { %>
          <div class="grid grid-3">
            <% products.forEach(p => { %>
              <article class="card glow-hover">
                <div class="card-img" style="background-image:url('<%= p.imageUrl %>'); background-size:cover; background-position:center;"></div>
                <h3 class="card-title"><%= p.title %></h3>
                <div class="card-meta">
                  <span class="price"><%= p.price %></span>
                  <div style="display:flex; gap:10px;">
                    <a class="btn btn-ghost" href="/admin/products/<%= p.id %>/edit">Edit</a>
                    <form method="POST" action="/admin/products/<%= p.id %>/delete" style="margin:0;">
                      <button class="btn btn-primary" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </main>

  <%- include('../components/footer') %>
</body>
</html>
