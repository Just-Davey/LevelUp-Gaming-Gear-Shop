<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page">
  <%- include('../components/header') %>

  <main>
    <div class="container">
      <section class="glass glow-pink form-card" style="max-width:760px; margin:0 auto;">
        <div class="badge">Admin • <%= mode === 'create' ? 'Add' : 'Edit' %> Product</div>
        <h1 class="h1"><%= mode === 'create' ? 'Add Product' : 'Edit Product' %></h1>

        <form method="POST" action="<%= mode === 'create' ? '/admin/products' : '/admin/products/' + product.id %>">
          <div class="field">
            <div class="label">Title</div>
            <input class="input" name="title" value="<%= product ? product.title : '' %>" required />
          </div>

          <div class="field">
            <div class="label">Price</div>
            <input class="input" type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required />
          </div>

          <div class="field">
            <div class="label">Image URL</div>
            <input class="input" name="imageUrl" value="<%= product ? product.imageUrl : '' %>" required />
          </div>

          <div class="field">
            <div class="label">Description</div>
            <textarea class="input" name="description" rows="5" required><%= product ? product.description : '' %></textarea>
          </div>

          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="btn btn-primary" type="submit"><%= mode === 'create' ? 'Create' : 'Save' %></button>
            <a class="btn btn-ghost" href="/admin/products">Cancel</a>
          </div>
        </form>
      </section>
    </div>
  </main>

  <%- include('../components/footer') %>
</body>
</html>
